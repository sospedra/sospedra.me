{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sospedra.me/schemas/bazaar3-assets-v1.json",
  "title": "Bazaar3 deterministic asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "assetRoot", "assets"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "assetRoot": {
      "type": "string",
      "minLength": 1
    },
    "reportPath": {
      "type": "string",
      "minLength": 1
    },
    "defaults": {
      "$ref": "#/$defs/checks"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "paletteFamilies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/paletteFamily"
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/animation"
      }
    }
  },
  "$defs": {
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alpha": {
          "oneOf": [
            {
              "const": false
            },
            {
              "$ref": "#/$defs/alphaRule"
            }
          ]
        },
        "palette": {
          "oneOf": [
            {
              "const": false
            },
            {
              "$ref": "#/$defs/paletteRule"
            }
          ]
        },
        "pixelBlock": {
          "oneOf": [
            {
              "const": false
            },
            {
              "$ref": "#/$defs/pixelBlockRule"
            }
          ]
        },
        "forbiddenColors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forbiddenColor"
          }
        }
      }
    },
    "alphaRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["any", "binary", "opaque"]
        },
        "requireChannel": {
          "type": "boolean"
        },
        "requireTransparent": {
          "type": "boolean"
        },
        "requireOpaque": {
          "type": "boolean"
        }
      }
    },
    "paletteRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxColors"],
      "properties": {
        "maxColors": {
          "type": "integer",
          "minimum": 1
        },
        "exactColors": {
          "type": "integer",
          "minimum": 1
        },
        "minAlpha": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "includeAlpha": {
          "type": "boolean"
        }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pixelBlockRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "rect": {
          "$ref": "#/$defs/rect"
        },
        "ignoreFullyTransparent": {
          "type": "boolean"
        }
      }
    },
    "forbiddenColor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hex"],
      "properties": {
        "hex": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        },
        "tolerance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "maxPixels": {
          "type": "integer",
          "minimum": 0
        },
        "minAlpha": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "width", "height"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "animation-cel",
            "effect-cel",
            "motion-mask",
            "static-layer",
            "environment",
            "reference"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "checks": {
          "$ref": "#/$defs/checks"
        }
      }
    },
    "rootAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "lockRadius"],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "lockRadius": {
          "type": "integer",
          "minimum": 0
        },
        "requireOpaque": {
          "type": "boolean"
        },
        "excludeFromMotionMask": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "lockedRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "x", "y", "width", "height"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "requireOpaque": {
          "type": "boolean"
        },
        "excludeFromMotionMask": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "paletteFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reference", "mode", "members"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": ["subset", "identical"]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxUnionColors": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "motionMask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset"],
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frames", "rootAnchor"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "frames": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rootAnchor": {
          "$ref": "#/$defs/rootAnchor"
        },
        "lockedRegions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedRegion"
          }
        },
        "allowedMotionMask": {
          "$ref": "#/$defs/motionMask"
        },
        "staticLayers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
