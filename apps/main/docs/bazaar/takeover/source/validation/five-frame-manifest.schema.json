{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sospedra.me/schemas/bazaar3-five-frame-registration-v1.json",
  "title": "Bazaar3 five-frame registration manifest",
  "type": "object",
  "required": [
    "version",
    "id",
    "logicalCanvas",
    "deliveryCanvas",
    "pixelScale",
    "finalRow",
    "baseState",
    "palette",
    "frames",
    "lockedRegions",
    "torsoRegions",
    "rootRegions",
    "shoulderRootRegions",
    "registrationAnchors"
  ],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "label": { "type": "string" },
    "reportDirectory": { "type": "string" },
    "logicalCanvas": { "$ref": "#/$defs/size" },
    "deliveryCanvas": { "$ref": "#/$defs/size" },
    "pixelScale": { "type": "integer", "minimum": 1 },
    "finalRow": {
      "type": "object",
      "required": ["count", "mode"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "mode": { "enum": ["duplicate-last", "transparent"] }
      }
    },
    "baseState": { "const": "idle-1" },
    "palette": {
      "type": "object",
      "required": ["maxColors", "mode"],
      "properties": {
        "maxColors": { "type": "integer", "minimum": 1 },
        "mode": { "enum": ["subset-of-base", "identical"] },
        "includeTransparent": { "type": "boolean" }
      }
    },
    "registrationSearchRadius": { "type": "integer", "minimum": 1 },
    "frames": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/frame" }
    },
    "lockedRegions": {
      "type": "array",
      "items": { "$ref": "#/$defs/lockedRegion" }
    },
    "torsoRegions": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedRect" }
    },
    "rootRegions": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedRect" }
    },
    "shoulderRootRegions": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedRect" }
    },
    "registrationAnchors": {
      "type": "array",
      "items": { "$ref": "#/$defs/namedRect" }
    },
    "designReviewZones": { "type": "array" }
  },
  "$defs": {
    "size": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "namedRect": {
      "type": "object",
      "required": ["id", "x", "y", "width", "height"],
      "properties": {
        "id": { "type": "string" },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "lockedRegion": {
      "allOf": [
        { "$ref": "#/$defs/namedRect" },
        {
          "type": "object",
          "required": ["category"],
          "properties": {
            "category": {
              "enum": ["sign", "counter", "floor", "background"]
            }
          }
        }
      ]
    },
    "frame": {
      "type": "object",
      "required": ["id", "file"],
      "properties": {
        "id": {
          "enum": ["idle-1", "idle-2", "hover-1", "hover-2", "hover-3"]
        },
        "file": { "type": "string" },
        "requireMotion": { "type": "boolean" },
        "motionMask": {
          "type": "object",
          "properties": {
            "file": { "type": "string" },
            "regions": { "type": "array" }
          }
        }
      }
    }
  }
}
