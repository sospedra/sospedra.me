{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@repo/biome-config/base.json"],
  "files": {
    "includes": [
      "**",
      "!next-env.d.ts",
      "!**/*.svg",
      "!public/vendor",
      "!docs",
      "!repo/crosswords/sources.lock.json",
      "!repo/papers/total-eclipse/data"
    ]
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "single"
    }
  },
  "linter": {
    "domains": {
      "react": "recommended",
      "next": "recommended",
      "project": "recommended"
    },
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "performance": {
        "noImgElement": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "scripts/**",
        "services/logger.ts",
        "services/easteregg/log.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
