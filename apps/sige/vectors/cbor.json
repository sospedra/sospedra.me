{
  "schemaVersion": 1,
  "category": "cbor",
  "description": "Canonical CBOR encodings (SIGE spec 6.1): shortest-form integers, definite lengths, map keys sorted by encoded bytes. value uses a tagged JsonCborValue shape (see src/core/vectors.ts): {type:\"int\"|\"bytes\"|\"text\"|\"bool\"|\"null\"|\"array\"|\"map\", value:...}, decimal strings for int, hex for bytes. encodeCbor(value) must equal expectedHex byte for byte; decodeCbor(expectedHex) must equal value. The only standing check here is that encode/decode round trip within one module (cbor.ts); unlike the other seven categories, there is no structurally independent standing recomputation. These hex values were hand-derived from RFC 8949's encoding rules as a one-time manual check during vector creation, most matching RFC 8949 Appendix A's own worked examples verbatim, but that check does not run again on every test invocation.",
  "seedDomain": "SIGE-VECTORS/v1",
  "vectors": [
    {
      "id": "uint-0",
      "description": "smallest unsigned integer",
      "value": {
        "type": "int",
        "value": "0"
      },
      "expectedHex": "00"
    },
    {
      "id": "uint-23",
      "description": "largest direct-argument unsigned integer",
      "value": {
        "type": "int",
        "value": "23"
      },
      "expectedHex": "17"
    },
    {
      "id": "uint-24",
      "description": "1-byte-argument boundary",
      "value": {
        "type": "int",
        "value": "24"
      },
      "expectedHex": "1818"
    },
    {
      "id": "uint-65535",
      "description": "2-byte-argument top edge",
      "value": {
        "type": "int",
        "value": "65535"
      },
      "expectedHex": "19ffff"
    },
    {
      "id": "uint-65536",
      "description": "4-byte-argument boundary",
      "value": {
        "type": "int",
        "value": "65536"
      },
      "expectedHex": "1a00010000"
    },
    {
      "id": "uint-2^32-1",
      "description": "4-byte-argument top edge",
      "value": {
        "type": "int",
        "value": "4294967295"
      },
      "expectedHex": "1affffffff"
    },
    {
      "id": "uint-2^64-1",
      "description": "largest representable unsigned integer",
      "value": {
        "type": "int",
        "value": "18446744073709551615"
      },
      "expectedHex": "1bffffffffffffffff"
    },
    {
      "id": "negint--1",
      "description": "smallest-magnitude negative integer",
      "value": {
        "type": "int",
        "value": "-1"
      },
      "expectedHex": "20"
    },
    {
      "id": "negint--24",
      "description": "largest direct-argument negative integer",
      "value": {
        "type": "int",
        "value": "-24"
      },
      "expectedHex": "37"
    },
    {
      "id": "negint--25",
      "description": "1-byte-argument boundary, negative",
      "value": {
        "type": "int",
        "value": "-25"
      },
      "expectedHex": "3818"
    },
    {
      "id": "negint--1000",
      "description": "2-byte-argument negative integer",
      "value": {
        "type": "int",
        "value": "-1000"
      },
      "expectedHex": "3903e7"
    },
    {
      "id": "negint--2^64",
      "description": "most negative representable integer",
      "value": {
        "type": "int",
        "value": "-18446744073709551616"
      },
      "expectedHex": "3bffffffffffffffff"
    },
    {
      "id": "bytes-empty",
      "description": "empty byte string",
      "value": {
        "type": "bytes",
        "value": ""
      },
      "expectedHex": "40"
    },
    {
      "id": "bytes-4",
      "description": "byte string h'01020304'",
      "value": {
        "type": "bytes",
        "value": "01020304"
      },
      "expectedHex": "4401020304"
    },
    {
      "id": "text-empty",
      "description": "empty text string",
      "value": {
        "type": "text",
        "value": ""
      },
      "expectedHex": "60"
    },
    {
      "id": "text-IETF",
      "description": "ascii text string",
      "value": {
        "type": "text",
        "value": "IETF"
      },
      "expectedHex": "6449455446"
    },
    {
      "id": "text-water",
      "description": "multi-byte utf-8 text string (3-byte codepoint)",
      "value": {
        "type": "text",
        "value": "水"
      },
      "expectedHex": "63e6b0b4"
    },
    {
      "id": "array-empty",
      "description": "empty array",
      "value": {
        "type": "array",
        "value": []
      },
      "expectedHex": "80"
    },
    {
      "id": "array-nested",
      "description": "nested array of small integers",
      "value": {
        "type": "array",
        "value": [
          {
            "type": "int",
            "value": "1"
          },
          {
            "type": "array",
            "value": [
              {
                "type": "int",
                "value": "2"
              },
              {
                "type": "int",
                "value": "3"
              }
            ]
          },
          {
            "type": "array",
            "value": [
              {
                "type": "int",
                "value": "4"
              },
              {
                "type": "int",
                "value": "5"
              }
            ]
          }
        ]
      },
      "expectedHex": "8301820203820405"
    },
    {
      "id": "map-empty",
      "description": "empty map",
      "value": {
        "type": "map",
        "value": []
      },
      "expectedHex": "a0"
    },
    {
      "id": "map-a1",
      "description": "single-entry map, text key",
      "value": {
        "type": "map",
        "value": [
          [
            "a",
            {
              "type": "int",
              "value": "1"
            }
          ]
        ]
      },
      "expectedHex": "a1616101"
    },
    {
      "id": "map-reorder",
      "description": "nested map whose keys require canonical reordering",
      "value": {
        "type": "map",
        "value": [
          [
            "z",
            {
              "type": "int",
              "value": "1"
            }
          ],
          [
            "a",
            {
              "type": "map",
              "value": [
                [
                  "y",
                  {
                    "type": "int",
                    "value": "2"
                  }
                ],
                [
                  "b",
                  {
                    "type": "int",
                    "value": "3"
                  }
                ]
              ]
            }
          ]
        ]
      },
      "expectedHex": "a26161a2616203617902617a01"
    },
    {
      "id": "bool-true",
      "description": "boolean true",
      "value": {
        "type": "bool",
        "value": true
      },
      "expectedHex": "f5"
    },
    {
      "id": "bool-false",
      "description": "boolean false",
      "value": {
        "type": "bool",
        "value": false
      },
      "expectedHex": "f4"
    },
    {
      "id": "null",
      "description": "null",
      "value": {
        "type": "null"
      },
      "expectedHex": "f6"
    }
  ]
}
