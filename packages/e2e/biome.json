{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@repo/biome-config/base.json"],
  "files": {
    "includes": ["**", "!test-results", "!playwright-report"]
  },
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "requireAscii": true,
            "filenameCases": ["kebab-case"]
          }
        }
      }
    }
  }
}
