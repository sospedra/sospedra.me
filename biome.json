{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!next-env.d.ts",
      "!**/*.svg",
      "!public/vendor",
      "!docs",
      "!repo/crosswords/sources.lock.json"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "domains": {
      "react": "recommended",
      "next": "recommended",
      "project": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 10 }
        },
        "noForEach": "error"
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "noUnusedPrivateClassMembers": "error",
        "useExhaustiveDependencies": "warn"
      },
      "performance": {
        "noImgElement": "off",
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "style": {
        "noEnum": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "requireAscii": false, "filenameCases": ["kebab-case"] }
        }
      },
      "suspicious": {
        "noImportCycles": "error",
        "noConsole": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "scripts/**",
        "services/logger.ts",
        "services/easteregg/log.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
